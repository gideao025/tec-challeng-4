# Copiado para .env por `make up` (scripts/preparar.sh), que troca cada "trocar" por um
# valor aleatório. O .env NUNCA é versionado.

# --- Rede -------------------------------------------------------------------
# Nome/IP pelo qual navegador, Postman e e-mails chegam à VM (resolva no /etc/hosts)
CLOUDLAB_HOST=cloudlab
# IP da docker0: Alternator, MinIO (API) e SMTP só escutam aqui; as funções do faasd
# (bridge openfaas0) alcançam esse IP pelo host, a rede local não.
HOST_INTERNO=172.17.0.1

# --- Imagens das funções ----------------------------------------------------
REGISTRY=ghcr.io/seu-grupo
TAG=0.1.0

# --- Keycloak ---------------------------------------------------------------
KEYCLOAK_URL=http://cloudlab:8180
POSTGRES_PASSWORD=trocar
KC_BOOTSTRAP_ADMIN_PASSWORD=trocar
KC_SENHA_ALUNO_DEMO=trocar
KC_SENHA_ADMIN_DEMO=trocar
# Chave RSA de assinatura do realm (gerada por scripts/preparar.sh)
KC_RSA_PRIVATE_KEY=

# --- Kong -------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000

# --- ScyllaDB Alternator (sem autenticação; o SDK exige credenciais) --------
ALTERNATOR_ACCESS_KEY=alternator
ALTERNATOR_SECRET_KEY=trocar

# --- MinIO ------------------------------------------------------------------
MINIO_ROOT_USER=root
MINIO_ROOT_PASSWORD=trocar
MINIO_BUCKET=feedback-relatorios
# usuário de serviço da função gerar-relatorio-semanal (só PutObject em relatorios/*)
MINIO_SVC_ACCESS_KEY=svc-relatorio
MINIO_SVC_SECRET_KEY=trocar
# usuário dos administradores (somente leitura dos relatórios, via console :9001)
MINIO_ADMIN_USER=admin-relatorios
MINIO_ADMIN_PASSWORD=trocar

# --- E-mail / Grafana -------------------------------------------------------
EMAIL_ADMINS=coordenacao@fiap.local
EMAIL_REMETENTE=feedback@cloudlab.local
GF_ADMIN_PASSWORD=trocar
