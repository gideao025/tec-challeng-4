        {
          "name": "429 - rate limit excedido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_aluno}}"
              }
            ],
            "url": {
              "raw": "{{kong_url}}/avaliacao",
              "host": [
                "{{kong_url}}"
              ],
              "path": [
                "avaliacao"
              ]
            },
            "description": "O pre-request envia requisições até o Kong devolver 429; esta deve receber 429. Aguarde 1 min para voltar a enviar.",
            "body": {
              "mode": "raw",
              "raw": "{\"descricao\":\"Depois do limite\",\"nota\":8}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('429', () => pm.response.to.have.status(429));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Envia requisições inválidas (nada é gravado) até o Kong responder 429 (limite: 30/min por IP).",
                  "// Sequencial e parando no primeiro 429, para não cruzar a virada da janela de 1 minuto.",
                  "const url = pm.variables.get('kong_url') + '/avaliacao';",
                  "const token = pm.variables.get('token_aluno');",
                  "function disparar(n) {",
                  "  if (n >= 60) return;",
                  "  pm.sendRequest({ url, method: 'POST',",
                  "    header: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },",
                  "    body: { mode: 'raw', raw: '{\"descricao\":\"rate\",\"nota\":99}' } },",
                  "    (err, res) => { if (!err && res.code !== 429) disparar(n + 1); });",
                  "}",
                  "disparar(0);"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}